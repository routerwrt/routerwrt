#!/bin/sh

. /lib/functions.sh

export IMAGE="$1"
COMMAND="$2"

export INTERACTIVE=0
export VERBOSE=1
export CONFFILES=/tmp/sysupgrade.conffiles

RAMFS_COPY_BIN=
RAMFS_COPY_DATA=

include /lib/upgrade


supivot() { # <new_root> <old_root>
	/bin/mount | grep "on $1 type" >/dev/null 2>&1 ||
		/bin/mount -o bind "$1" "$1"

	mkdir -p "$1$2" "$1/proc" "$1/sys" "$1/dev" "$1/tmp" "$1/overlay" && \
	/bin/mount -o noatime,move /proc "$1/proc" && \
	pivot_root "$1" "$1$2" || {
		/bin/umount -l "$1" "$1"
		return 1
	}

	/bin/mount -o noatime,move "$2/sys" /sys
	/bin/mount -o noatime,move "$2/dev" /dev
	/bin/mount -o noatime,move "$2/tmp" /tmp
	/bin/mount -o noatime,move "$2/overlay" /overlay 2>/dev/null

	return 0
}


switch_to_ramfs() {
	for binary in \
		/bin/busybox \
		/bin/ash \
		/bin/sh \
		/bin/mount \
		/bin/umount \
		pivot_root \
		mount_root \
		reboot \
		sync \
		kill \
		sleep \
		hexdump \
		cat \
		zcat \
		dd \
		tar \
		gzip \
		ls \
		basename \
		find \
		cp \
		mv \
		rm \
		mkdir \
		rmdir \
		mknod \
		touch \
		chmod \
		'[' \
		printf \
		wc \
		grep \
		awk \
		sed \
		cut \
		sort \
		tail \
		date \
		mtd \
		fwtool \
		$RAMFS_COPY_BIN
	do
		file="$(command -v "$binary" 2>/dev/null)"
		[ -n "$file" ] && install_bin "$file"
	done

	install_file \
		/lib/*.sh \
		/lib/functions/*.sh \
		/lib/upgrade/*.sh \
		/lib/upgrade/do_stage2 \
		$RAMFS_COPY_DATA

	mkdir -p "$RAM_ROOT/var/lock"

	[ -L /lib64 ] &&
		ln -s /lib "$RAM_ROOT/lib64"

	supivot "$RAM_ROOT" /mnt || {
		v "Failed to switch to ramfs. Please reboot."
		exit 1
	}

	/bin/mount -o remount,ro /mnt 2>/dev/null
	/bin/umount -l /mnt

	if grep -q ' /overlay ' /proc/mounts; then
		/bin/mount -o noatime,remount,ro /overlay 2>/dev/null
		/bin/umount -l /overlay
	fi
}


stop_services() {
	for service in /etc/service/*; do
		[ -e "$service" ] || continue
		sv down "$service" 2>/dev/null
	done
}


kill_remaining() { # [ <signal> [ <loop> ] ]
	local loop_limit=10
	local sig="${1:-TERM}"
	local loop="${2:-0}"
	local run=true
	local stat

	v "Sending $sig to remaining processes..."

	while $run; do
		run=false

		for stat in /proc/[0-9]*/stat; do
			[ -f "$stat" ] || continue

			local pid name state ppid rest cmdline

			read -r pid rest < "$stat"

			name="${rest#\(}"
			rest="${name##*\) }"
			name="${name%\)*}"

			set -- $rest
			state="$1"
			ppid="$2"

			# Skip PID 1, ourselves and our direct children.
			[ "$pid" -ne 1 ] &&
			[ "$pid" -ne "$$" ] &&
			[ "$ppid" -ne "$$" ] ||
				continue

			[ -f "/proc/$pid/cmdline" ] || continue

			read -r cmdline < "/proc/$pid/cmdline"

			# Empty cmdline = kernel thread.
			[ -n "$cmdline" ] || continue

			v "Sending signal $sig to $name ($pid)"
			kill "-$sig" "$pid" 2>/dev/null

			if [ "$loop" -eq 1 ]; then
				sleep 2
				run=true
			fi
		done

		loop_limit=$((loop_limit - 1))

		[ "$loop_limit" -gt 0 ] || {
			v "Failed to kill all processes."
			exit 1
		}
	done
}

indicate_upgrade

v "Stopping services..."
stop_services

sleep 1

kill_remaining TERM
sleep 2
kill_remaining KILL 1

sync
echo 3 > /proc/sys/vm/drop_caches

if [ -n "$IMAGE" ] &&
   type platform_pre_upgrade >/dev/null 2>&1; then
	platform_pre_upgrade "$IMAGE"
fi

if [ -n "$(rootfs_type)" ]; then
	v "Switching to ramdisk..."
	switch_to_ramfs
fi

exec /bin/busybox ash -c "$COMMAND"
