#!/bin/sh
#
# RouterWRT sysupgrade
#
# Local firmware images only.
# Configuration preservation:
#   - /etc/sysupgrade.conf
#   - /lib/upgrade/keep.d/*
#   - changed APK conffiles
#
# No:
#   - OPKG
#   - UCI
#   - ubus
#   - jshn/libubox
#   - wget / remote URLs
#

. /lib/functions.sh


# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

CONF_TAR=/tmp/sysupgrade.tgz
CONFFILES=/tmp/sysupgrade.conffiles
COMMAND=/lib/upgrade/do_stage2


# ---------------------------------------------------------------------------
# Globals used by upgrade/platform scripts
# ---------------------------------------------------------------------------

export MTD_ARGS=""
export MTD_CONFIG_ARGS=""

export INTERACTIVE=0
export VERBOSE=1
export SAVE_CONFIG=1
export IGNORE_MINOR_COMPAT=0
export FORCE=0

export CONFFILES


# ---------------------------------------------------------------------------
# Local state
# ---------------------------------------------------------------------------

CONF_BACKUP=
CONF_RESTORE=
CONF_BACKUP_LIST=0
TEST=0


# ---------------------------------------------------------------------------
# Load generic + target/subtarget upgrade implementation
# ---------------------------------------------------------------------------

include /lib/upgrade


usage()
{
	cat <<EOF
Usage:
  $0 [options] <image>

Options:
  -i        interactive mode
  -n        do not preserve configuration
  -F        force upgrade if a forceable image check fails
  -T        test image only; do not flash
  -q        less verbose
  -v        more verbose
  -h        show this help

  --ignore-minor-compat-version
            allow keeping configuration across a minor compat change

Backup commands:
  -b <file> create configuration backup and exit
  -r <file> restore configuration backup and exit
  -l        list files that would be preserved

Firmware images must already exist on the router.
There is no URL/wget download support.
EOF
}


# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

while [ $# -gt 0 ]; do
	case "$1" in
		-i)
			export INTERACTIVE=1
			;;

		-n)
			export SAVE_CONFIG=0
			;;

		-F|--force)
			export FORCE=1
			;;

		-T|--test)
			TEST=1
			;;

		-q)
			export VERBOSE=$((VERBOSE - 1))
			;;

		-v)
			export VERBOSE=$((VERBOSE + 1))
			;;

		--ignore-minor-compat-version)
			export IGNORE_MINOR_COMPAT=1
			;;

		-b|--create-backup)
			[ $# -ge 2 ] || {
				echo "Missing backup filename" >&2
				exit 1
			}

			CONF_BACKUP="$2"
			shift
			;;

		-r|--restore-backup)
			[ $# -ge 2 ] || {
				echo "Missing backup filename" >&2
				exit 1
			}

			CONF_RESTORE="$2"
			shift
			;;

		-l|--list-backup)
			CONF_BACKUP_LIST=1
			;;

		-h|--help)
			usage
			exit 0
			;;

		-*)
			echo "Unknown option: $1" >&2
			usage >&2
			exit 1
			;;

		*)
			break
			;;
	esac

	shift
done

IMAGE="$1"


# ---------------------------------------------------------------------------
# APK configuration files
# ---------------------------------------------------------------------------

list_apk_conffiles()
{
	local file

	[ -d /lib/apk/packages ] || return 0

	for file in /lib/apk/packages/*.conffiles_static; do
		[ -f "$file" ] || continue
		cat "$file"
	done
}


list_changed_apk_conffiles()
{
	local file csum

	list_apk_conffiles |
	while read -r file csum; do
		[ -n "$file" ] || continue
		[ -r "$file" ] || continue

		#
		# APK stores the original checksum. Preserve only files which
		# differ from the packaged version.
		#
		if [ -n "$csum" ]; then
			echo "$csum  $file" |
				busybox sha256sum -sc - >/dev/null 2>&1 ||
				echo "$file"
		else
			#
			# Be conservative if metadata has no checksum.
			#
			echo "$file"
		fi
	done
}


# ---------------------------------------------------------------------------
# Explicit RouterWRT keep files
# ---------------------------------------------------------------------------

list_static_conffiles()
{
	local paths

	paths="$(
		sed -ne '
			/^[[:space:]]*$/d
			/^[[:space:]]*#/d
			p
		' \
		/etc/sysupgrade.conf \
		/lib/upgrade/keep.d/* \
		2>/dev/null
	)"

	[ -n "$paths" ] || return 0

	find $paths \
		\( -type f -o -type l \) \
		2>/dev/null
}


build_backup_list()
{
	local outfile="$1"

	{
		list_static_conffiles
		list_changed_apk_conffiles
	} |
		sort -u > "$outfile"
}


# ---------------------------------------------------------------------------
# Configuration archive
# ---------------------------------------------------------------------------

create_backup_archive()
{
	local archive="$1"
	local list=/tmp/sysupgrade.conffiles.relative

	if [ "$(rootfs_type)" = "tmpfs" ]; then
		echo "Cannot save configuration while running from ramdisk." >&2
		return 1
	fi

	build_backup_list "$CONFFILES" || return 1

	#
	# tar -C / expects paths without a leading slash.
	#
	sed 's,^/,,' "$CONFFILES" > "$list"

	v "Saving configuration..."

	if [ "$VERBOSE" -gt 1 ]; then
		tar -C / -czvf "$archive" -T "$list"
	else
		tar -C / -czf "$archive" -T "$list"
	fi

	local ret=$?

	rm -f "$list" "$CONFFILES"

	if [ "$ret" -ne 0 ]; then
		echo "Failed to create configuration backup." >&2
		rm -f "$archive"
		return "$ret"
	fi

	return 0
}


restore_backup_archive()
{
	local archive="$1"

	[ -f "$archive" ] || {
		echo "Backup archive not found: $archive" >&2
		return 1
	}

	case "$(get_magic_word "$archive" cat)" in
		1f8b)
			;;
		*)
			echo "Invalid backup archive; expected .tar.gz" >&2
			return 1
			;;
	esac

	v "Restoring configuration..."

	if type platform_restore_backup >/dev/null 2>&1; then
		platform_restore_backup
	else
		tar -C / -xzf "$archive"
	fi
}


# ---------------------------------------------------------------------------
# Standalone backup operations
# ---------------------------------------------------------------------------

if [ "$CONF_BACKUP_LIST" -eq 1 ]; then
	build_backup_list "$CONFFILES"
	cat "$CONFFILES"
	rm -f "$CONFFILES"
	exit 0
fi


if [ -n "$CONF_BACKUP" ]; then
	create_backup_archive "$CONF_BACKUP"
	exit $?
fi


if [ -n "$CONF_RESTORE" ]; then
	restore_backup_archive "$CONF_RESTORE"
	exit $?
fi


# ---------------------------------------------------------------------------
# Firmware image
# ---------------------------------------------------------------------------

[ -n "$IMAGE" ] || {
	usage
	exit 1
}

IMAGE="$(readlink -f "$IMAGE")"

[ -f "$IMAGE" ] || {
	echo "Firmware image not found: $IMAGE" >&2
	exit 1
}


#
# The image must survive the RAM-root pivot.
# /tmp is moved into the RAM root by stage2.
#
case "$IMAGE" in
	/tmp/*)
		;;

	*)
		v "Copying firmware image to /tmp..."

		cp -f "$IMAGE" /tmp/sysupgrade.img || {
			echo "Failed to copy firmware image to /tmp." >&2
			exit 1
		}

		IMAGE=/tmp/sysupgrade.img
		;;
esac


# ---------------------------------------------------------------------------
# Image validation
#
# This replaces /usr/libexec/validate_firmware_image and therefore avoids
# its jshn/functions.system/JSON dependency.
# ---------------------------------------------------------------------------

VALID=1
FORCEABLE=1
ALLOW_BACKUP=1


#
# Some platform_check_image() implementations use these callbacks.
#
notify_firmware_invalid()
{
	VALID=0
}


notify_firmware_broken()
{
	VALID=0
	FORCEABLE=0
}


notify_firmware_no_backup()
{
	ALLOW_BACKUP=0
}


#
# We don't need structured per-test JSON results.
#
notify_firmware_test_result()
{
	:
}


#
# fwtool signature
#
if type fwtool_check_signature >/dev/null 2>&1; then
	if ! fwtool_check_signature "$IMAGE"; then
		VALID=0
	fi
fi


#
# fwtool metadata / board compatibility
#
if type fwtool_check_image >/dev/null 2>&1; then
	if ! fwtool_check_image "$IMAGE"; then
		VALID=0
	fi
fi


#
# Platform-specific validation
#
type platform_check_image >/dev/null 2>&1 || {
	echo "Firmware upgrade is not implemented for this platform." >&2
	exit 1
}

platform_check_image "$IMAGE"
platform_result=$?

case "$platform_result" in
	0)
		;;

	74)
		#
		# OpenWrt convention: return 74 means broken/non-forceable image.
		#
		VALID=0
		FORCEABLE=0
		;;

	*)
		VALID=0
		;;
esac


#
# Process validation result.
#
if [ "$VALID" -eq 0 ]; then
	if [ "$FORCEABLE" -eq 0 ]; then
		echo "Firmware image is broken and cannot be installed." >&2
		exit 1
	fi

	if [ "$FORCE" -ne 1 ]; then
		echo "Firmware image validation failed." >&2
		echo "Use sysupgrade -F only if you are certain this image is correct." >&2
		exit 1
	fi

	echo "WARNING: image validation failed; forcing upgrade." >&2
fi


#
# Some image transitions explicitly prohibit preserving configuration.
#
if [ "$SAVE_CONFIG" -eq 1 ] && [ "$ALLOW_BACKUP" -eq 0 ]; then
	echo "This image does not allow configuration preservation." >&2
	echo "Upgrade with 'sysupgrade -n' instead." >&2
	exit 1
fi


# ---------------------------------------------------------------------------
# Test-only mode
# ---------------------------------------------------------------------------

if [ "$TEST" -eq 1 ]; then
	v "Firmware image validation successful."
	exit 0
fi


# ---------------------------------------------------------------------------
# Configuration preservation
# ---------------------------------------------------------------------------

if ask_bool "$SAVE_CONFIG" "Keep configuration over reflash"; then
	create_backup_archive "$CONF_TAR" || exit 1
	export SAVE_CONFIG=1
	export UPGRADE_BACKUP="$CONF_TAR"
else
	rm -f "$CONF_TAR"
	export SAVE_CONFIG=0
	unset UPGRADE_BACKUP
fi


# ---------------------------------------------------------------------------
# Final interactive confirmation
#
# GUI callers do their own confirmation and normally do not use -i.
# ---------------------------------------------------------------------------

if [ "$INTERACTIVE" -eq 1 ]; then
	ask_bool 0 "Flash firmware and reboot" || {
		echo "Upgrade cancelled."
		exit 0
	}
fi


# ---------------------------------------------------------------------------
# Upgrade
# ---------------------------------------------------------------------------

v "Commencing system upgrade..."

#
# RouterWRT does not use procd/ubus to enter stage2.
#
# stage2 stops runit-managed services, kills remaining userspace,
# constructs the RAM root, pivots away from the live filesystem and
# executes do_stage2.
#
exec /lib/upgrade/stage2 "$IMAGE" "$COMMAND"

echo "Failed to start upgrade stage2." >&2
exit 1
